{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability set for the MermaidDesk main window. Filesystem and dialog access is implemented in Rust commands instead of broad webview permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging"
  ]
}
