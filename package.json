{
    "name":  "mermaid-desk",
    "private":  true,
    "version":  "1.0.0",
    "description":  "Offline-first desktop editor for Mermaid diagrams",
    "license":  "MIT",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc --noEmit \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "tauri":  "tauri",
                    "tauri:dev":  "tauri dev",
                    "tauri:build":  "tauri build",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:e2e":  "playwright test",
                    "typecheck":  "tsc --noEmit",
                    "test:desktop":  "node scripts/desktop-e2e.mjs"
                },
    "dependencies":  {
                         "@tauri-apps/api":  "^2.12.5",
                         "@tauri-apps/plugin-dialog":  "^2.8.4",
                         "@tauri-apps/plugin-opener":  "^2.7.3",
                         "dompurify":  "^3.4.18",
                         "mermaid":  "^12.3.0",
                         "monaco-editor":  "^0.55.1",
                         "react":  "^19.3.1",
                         "react-dom":  "^19.3.1"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.56.0",
                            "@tauri-apps/cli":  "^2.12.6",
                            "@testing-library/dom":  "^10.4.1",
                            "@testing-library/jest-dom":  "^6.9.1",
                            "@testing-library/react":  "^16.3.2",
                            "@testing-library/user-event":  "^14.6.1",
                            "@types/react":  "^19.2.0",
                            "@types/react-dom":  "^19.2.0",
                            "@types/selenium-webdriver":  "^4.35.7",
                            "@vitejs/plugin-react":  "^5.1.0",
                            "happy-dom":  "^20.0.0",
                            "selenium-webdriver":  "^4.51.0",
                            "typescript":  "^5.9.0",
                            "vite":  "^7.1.0",
                            "vitest":  "^3.2.0"
                        },
    "allowScripts":  {
                         "esbuild@0.28.2":  true
                     }
}
